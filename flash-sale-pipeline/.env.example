# ============================================================================
# Flash Sale Distributed Pipeline - Environment Configuration
# Copy this file to ".env" before running docker compose:
#   cp .env.example .env
# ============================================================================

# ---- Kafka -----------------------------------------------------------------
KAFKA_TOPIC=clickstream-events
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
# Fixed cluster id shared by all 3 brokers (must be the same 22-char base64 string everywhere)
KAFKA_KRAFT_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ---- Citus / PostgreSQL ------------------------------------------------------
CITUS_USER=citus
CITUS_PASSWORD=citus_pw_change_me
CITUS_DB=citus
# Host port mapped to the coordinator's 5432 (kept non-default to avoid clashing
# with a local Postgres install on your laptop)
CITUS_HOST_PORT=5433

# ---- Spark -------------------------------------------------------------------
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G
# Maven coordinates pulled at spark-submit time (needs internet on first run)
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1
SPARK_PG_JDBC_PACKAGE=org.postgresql:postgresql:42.7.4

# ---- Synthetic Data Generator (Producer) -------------------------------------
# "auto"   -> automatically cycles NORMAL -> FLASH_SALE -> NORMAL forever
# "manual" -> stays NORMAL until a burst is triggered via scripts/trigger_burst.sh
PRODUCER_MODE=auto
PRODUCER_NORMAL_EPS=100
PRODUCER_BURST_EPS=10000
PRODUCER_NORMAL_DURATION_SEC=120
PRODUCER_BURST_DURATION_SEC=30
# Fraction of traffic during a burst that behaves like a scalper/bot (0.0-1.0)
PRODUCER_BOT_RATIO=0.15
PRODUCER_CATALOG_SIZE=200

# ---- Anomaly detection thresholds (used by the Spark job) --------------------
# An ip_address is flagged as bot-like if it issues more than this many events
# inside a single micro-batch window (see SPARK_TRIGGER_INTERVAL_SEC below)
ANOMALY_EVENTS_PER_IP_THRESHOLD=25
SPARK_TRIGGER_INTERVAL_SEC=5

# ---- Monitoring ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_change_me
